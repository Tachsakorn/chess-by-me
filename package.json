{
  "name": "chess-by-me",
  "private": true,
  "version": "1.1.1",
  "description": "Chess by me: in-browser chess game review.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-engines.mjs && tsc --noEmit && vite build",
    "build:preview": "npm run build && node scripts/preview-files.mjs",
    "build:production": "npm run build && node scripts/production-files.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "engines:copy": "node scripts/copy-engines.mjs",
    "fixture:make": "vitest run --config vitest.scripts.config.ts make-fixture",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "script": "vitest run --config vitest.scripts.config.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts && playwright test -c e2e/playwright.prod.config.ts && playwright test -c e2e/playwright.release.config.ts",
    "e2e:release": "playwright test -c e2e/playwright.release.config.ts"
  },
  "dependencies": {
    "@fontsource/anuphan": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@lichess-org/chessground": "10.5.0",
    "chess.js": "1.4.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "stockfish": "17.1.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
